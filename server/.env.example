# Local development only. Do NOT commit the real .env file.
# Copy this file to .env and fill in your values.

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_secret_here

# Comma-separated list of allowed origins (no trailing slash)
# Local dev:
CORS_ORIGIN=http://localhost:5173
# Production (set this in Vercel dashboard, not here):
# CORS_ORIGIN=https://stock-predictor-ten-lime.vercel.app

# Set automatically by Vercel service bindings in production
ML_SERVICE_URL=http://localhost:8000

# NODE_ENV is set automatically by Vercel to "production"
NODE_ENV=development
